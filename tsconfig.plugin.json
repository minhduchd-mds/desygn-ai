{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@figma"
    ]
  },
  "files": [
    "node_modules/@figma/plugin-typings/index.d.ts"
  ],
  "include": [
    "plugin/**/*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
